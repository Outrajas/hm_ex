@"
# Datasets (external)
datasets/
*.zip
*.tar
*.tar.gz

# Model weights / binaries
*.pt
*.pth
*.onnx
*.h5
*.ckpt
*.pkl

# Cached tensors / arrays (large)
*.npz
*.npy

# Generated experiment artifacts (keep .py scripts)
experiments/dataset_cache/
experiments/evidence_inspection/*.png
experiments/failure_cases/*.png
experiments/subset_validation/*.png
experiments/*.csv

# Models folder (keep placeholder)
models/*
!models/.gitkeep

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/
"@ | Out-File -Encoding utf8 .gitignore